# All optional. Copy to .env or set in the shell. Never commit real values.
PORT=3200
# O*NET Web Services key (free, https://services.onetcenter.org). Without it the occupation lookup answers 'cached'.
# ONET_API_KEY=
# L3 semantic match: a RunPod serverless endpoint serving an embedding model (OpenAI-compatible /embeddings).
# Without these, L3 is skipped and the extraction answer says 'semantic_unavailable'.
# SEMANTIC_URL=https://api.runpod.ai/v2/<endpoint id>/openai/v1
# SEMANTIC_KEY=
# SEMANTIC_MODEL=BAAI/bge-m3
# Cutoff chosen by Model Eval (node scripts/model-eval.mjs, see docs/model-eval.md). Not set → L3 is not used.
# SEMANTIC_CUTOFF=
# Cloudflare D1 (accounts and saved profiles). Without these, accounts say "not available on this server".
# D1_ACCOUNT_ID=
# D1_DATABASE_ID=
# D1_TOKEN=
# Cloudflare R2 (temporary CV copy cv-temp/<extractionId>; add a 1-day lifecycle rule on the bucket).
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# AI re-extraction (only with the user's consent). RunPod first, Claude as backup. Without both, the AI re-read says "not configured".
# CV_LLM_URL=https://api.runpod.ai/v2/<endpoint id>/openai/v1
# CV_LLM_KEY=
# CV_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# CV_LLM_BACKUP_KEY=
# CV_LLM_BACKUP_MODEL=claude-opus-5-5
# Future Skills Radar. Without R2 (above) the Radar serves the bundled data in data/radar/bundle read-only;
# refresh, mapping approval, break review and judge sessions then say "not available on this server".
# With R2 the first request copies the bundled data to prod/ in the bucket (checked), then serves it from there.
# OpenAlex key, required for a deployed admin refresh (without it the refresh answers openalex_key_missing).
# OPENALEX_API_KEY=
# Local development only: RADAR_STORE=memory keeps Radar writes in memory (lost on restart; screens say
# "Development store - not durable"). Refused when NODE_ENV=production.
# RADAR_STORE=memory
# Admin and judge (demo) access keys and the secret that signs their sessions (at least 32 bytes). Missing, a short
# secret, or the same key for both roles -> those logins and routes answer not_configured.
# RADAR_ADMIN_KEY=
# RADAR_DEMO_KEY=
# RADAR_SESSION_SECRET=
# Compare futures AI news: DeepSeek Search key (PAID, US$0.75 per 1,000 successful searches; one search per study
# field every 3 hours while the server runs, at most 80 a day). Without it the news screen says "News is off".
# DEEPSEEK_API_KEY=
# Behind a reverse proxy (e.g. a hosting platform): the number of proxy hops, so per-visitor limits use the real address.
# TRUST_PROXY=1
