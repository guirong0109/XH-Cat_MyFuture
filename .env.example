# All optional. Copy to .env or set in the shell. Never commit real values.
PORT=3200
# O*NET Web Services key (free, https://services.onetcenter.org). Without it the occupation lookup answers 'cached'.
# ONET_API_KEY=
# L3 semantic match: a RunPod serverless endpoint serving an embedding model (OpenAI-compatible /embeddings).
# Without these, L3 is skipped and the extraction answer says 'semantic_unavailable'.
# SEMANTIC_URL=https://api.runpod.ai/v2/<endpoint id>/openai/v1
# SEMANTIC_KEY=
# SEMANTIC_MODEL=BAAI/bge-m3
# Cutoff chosen by Model Eval (node scripts/model-eval.mjs, see docs/model-eval.md). Not set → L3 is not used.
# SEMANTIC_CUTOFF=
